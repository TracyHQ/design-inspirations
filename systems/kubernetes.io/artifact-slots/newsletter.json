{"slots":[{"id":"p.0","tag":"p","n":0,"role":"eyebrow","group":null,"inNav":false,"text":"In this issue","chars":13,"words":3},{"id":"h1.0","tag":"h1","n":0,"role":"headline","group":null,"inNav":false,"text":"Production-Grade Container Orchestration","chars":40,"words":3},{"id":"p.1","tag":"p","n":1,"role":"paragraph","group":null,"inNav":false,"text":"Kubernetes, also known as K8s, is an open source system for automating deployment, scaling, and management of containerized applications. It groups containers that make up an application into logical units for easy management and discovery. Kubernetes builds upon 15 years of experience of running production workloads at Google, combined with best-of-breed ideas and practices from the community. Planet scaleDesigned on the same principles that allow Google to run billions of containers a week, Kubernetes can scale without increasing your operations team.","chars":559,"words":81},{"id":"a.0","tag":"a","n":0,"role":"button","group":null,"inNav":false,"text":"Read this issue","chars":15,"words":3},{"id":"h2.0","tag":"h2","n":0,"role":"title","group":null,"inNav":false,"text":"Production-Grade Container Orchestration","chars":40,"words":3},{"id":"p.2","tag":"p","n":2,"role":"paragraph","group":null,"inNav":false,"text":"Connect your existing stack and go live without a migration project.","chars":68,"words":11},{"id":"a.1","tag":"a","n":1,"role":"link","group":null,"inNav":false,"text":"Read the full story →","chars":21,"words":5},{"id":"h2.1","tag":"h2","n":1,"role":"title","group":null,"inNav":false,"text":"The Absolute Beginner's Guide To Cloud Native","chars":45,"words":7},{"id":"p.3","tag":"p","n":3,"role":"paragraph","group":null,"inNav":false,"text":"One shared source of truth, so everyone ships from the same page.","chars":65,"words":12},{"id":"a.2","tag":"a","n":2,"role":"link","group":null,"inNav":false,"text":"See how it works →","chars":18,"words":5},{"id":"h2.2","tag":"h2","n":2,"role":"title","group":null,"i