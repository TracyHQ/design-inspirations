{"slots":[{"id":"span.0","tag":"span","n":0,"role":"eyebrow","group":null,"inNav":true,"text":"Typography and color","chars":20,"words":3},{"id":"h1.0","tag":"h1","n":0,"role":"headline","group":null,"inNav":true,"text":"Nuxt","chars":4,"words":1},{"id":"p.0","tag":"p","n":0,"role":"label","group":null,"inNav":true,"text":"The Full-Stack Vue Framework","chars":28,"words":4},{"id":"h2.0","tag":"h2","n":0,"role":"title","group":null,"inNav":false,"text":"Type scale","chars":10,"words":2},{"id":"h1.1","tag":"h1","n":1,"role":"headline","group":null,"inNav":false,"text":"Every Nuxt page starts with one clear sentence.","chars":47,"words":8},{"id":"h2.1","tag":"h2","n":1,"role":"title","group":null,"inNav":false,"text":"Sections read as a sequence of assertions.","chars":42,"words":7},{"id":"h3.0","tag":"h3","n":0,"role":"subtitle","group":null,"inNav":false,"text":"Cards, tabs and dialogs share this size.","chars":40,"words":7},{"id":"h4.0","tag":"h4","n":0,"role":"subtitle","group":null,"inNav":false,"text":"Captions that still carry meaning.","chars":34,"words":5},{"id":"p.1","tag":"p","n":1,"role":"paragraph","group":null,"inNav":false,"text":"The lead paragraph sets the pace: one idea, said once, in Nuxt's voice.","chars":71,"words":13},{"id":"p.2","tag":"p","n":2,"role":"paragraph","group":null,"inNav":false,"text":"Body text carries the argument. It should read at arm's length on a phone and stay calm on a wide screen, with a measure of about seventy characters and a line height of 1.57.","chars":175,"words":34},{"id":"p.3","tag":"p","n":3,"role":"paragraph","group":null,"inNav":false,"text":"Small text is for metadata, timestamps and helper lines, never for anything the reader must not miss.","chars":101,"words":17}]}
