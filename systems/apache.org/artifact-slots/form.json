{"slots":[{"id":"span.1","tag":"span","n":1,"role":"label","group":null,"inNav":false,"text":"Apache Software Foundation","chars":26,"words":3},{"id":"h1.0","tag":"h1","n":0,"role":"headline","group":null,"inNav":false,"text":"Software For The Public Good ¶","chars":30,"words":6},{"id":"p.0","tag":"p","n":0,"role":"paragraph","group":null,"inNav":false,"text":"The Apache® Software Foundation (ASF) provides software for the public good, guided by community over code. Like the enduring oak tree, our projects thrive through the contributions of thousands worldwide.","chars":205,"words":30},{"id":"span.2","tag":"span","n":2,"role":"paragraph","group":null,"inNav":false,"text":"Software For The Public Good &para;","chars":35,"words":6},{"id":"span.3","tag":"span","n":3,"role":"label","group":null,"inNav":false,"text":"Our Impact &para;","chars":17,"words":3},{"id":"span.4","tag":"span","n":4,"role":"label","group":null,"inNav":false,"text":"Our Open Source Projects &para;","chars":31,"words":5},{"id":"span.6","tag":"span","n":6,"role":"paragraph","group":null,"inNav":false,"text":"It's free to start, and you're in good hands the whole way.","chars":59,"words":12},{"id":"h2.0","tag":"h2","n":0,"role":"title","group":null,"inNav":true,"text":"Tell us where to start","chars":22,"words":5},{"id":"p.1","tag":"p","n":1,"role":"paragraph","group":null,"inNav":true,"text":"A couple of details and Apache Software Foundation takes it from there — no account needed yet.","chars":95,"words":17},{"id":"span.7","tag":"span","n":7,"role":"label","group":null,"inNav":false,"text":"First name","chars":10,"words":2},{"id":"span.8","tag":"span","n":8,"role":"label","group":null,"inNav":false,"text":"Last name","chars":9,"words":2},{"id":"span.9","tag":"span","n":9,"role":"label","group":null,"inNav":false,"text":"Work email","chars":10,"words":2},{"id":"p.2","tag":"p","n":2,"role":"paragraph","group":null,"inNav":false,"text":"That doesn't look like an email yet — try name@company.com.","chars":59,"words":10},{"id":"p.3","tag":"p","n":3,"role":"paragraph","group":null,"inNav":false,"text":"We'll send your next steps here.","chars":32,"words":6},{"id":"span.10","tag":"span","n":10,"role":"label","group":null,"inNav":false,"text":"What can we help with?","chars":22,"words":5},{"id":"option.0","tag":"option","n":0,"role":"label","group":null,"inNav":false,"text":"Choose one…","chars":11,"words":2},{"id":"option.1","tag":"option","n":1,"role":"label","group":null,"inNav":false,"text":"Software For The Public Good &para;","chars":35,"words":6},{"id":"option.2","tag":"option","n":2,"role":"label","group":null,"inNav":false,"text":"Our Impact &para;","chars":17,"words":3},{"id":"option.3","tag":"option","n":3,"role":"label","group":null,"inNav":false,"text":"Our Open Source Projects &para;","chars":31,"words":5},{"id":"p.4","tag":"p","n":4,"role":"paragraph","group":null,"inNav":false,"text":"Pick the closest — you can change direction later.","chars":50,"words":9},{"id":"span.11","tag":"span","n":11,"role":"label","group":null,"inNav":false,"text":"Anything we should know?","chars":24,"words":4},{"id":"span.12","tag":"span","n":12,"role":"label","group":null,"inNav":false,"text":"Optional","chars":8,"words":1},{"id":"span.13","tag":"span","n":13,"role":"paragraph","group":null,"inNav":false,"text":"Keep me posted on what's new at Apache Software Foundation. No noise, easy to turn off.","chars":87,"words":16},{"id":"a.0","tag":"a","n":0,"role":"button","group":null,"inNav":false,"text":"Get started with Apache Software Foundation","chars":43,"words":6},{"id":"span.14","tag":"span","n":14,"role":"paragraph","group":null,"inNav":false,"text":"No spam, ever. Unsubscribe in one click — your data stays yours.","chars":64,"words":12},{"id":"h2.1","tag":"h2","n":1,"role":"title","group":null,"inNav":false,"text":"You're in.","chars":10,"words":2},{"id":"p.6","tag":"p","n":6,"role":"paragraph","group":null,"inNav":false,"text":"Check your inbox for a note from Apache Software Foundation — your next step is waiting there. We usually reply within one business day.","chars":136,"words":24},{"id":"span.18","tag":"span","n":18,"role":"paragraph","group":null,"inNav":false,"text":"Software For The Public Good ¶","chars":30,"words":6},{"id":"span.19","tag":"span","n":19,"role":"label","group":null,"inNav":false,"text":"apache.org","chars":10,"words":1}]}
