{"slots":[{"id":"span.1","tag":"span","n":1,"role":"label","group":null,"inNav":false,"text":"debian.org","chars":10,"words":1},{"id":"h1.0","tag":"h1","n":0,"role":"headline","group":null,"inNav":false,"text":"Debian -- The Universal Operating System","chars":40,"words":6},{"id":"p.0","tag":"p","n":0,"role":"paragraph","group":null,"inNav":false,"text":"Debian is an operating system and a distribution of Free Software. It is maintained and updated through the work of many users who volunteer their time and effort.","chars":163,"words":28},{"id":"span.2","tag":"span","n":2,"role":"label","group":null,"inNav":false,"text":"Debian","chars":6,"words":1},{"id":"span.3","tag":"span","n":3,"role":"label","group":null,"inNav":false,"text":"The Community","chars":13,"words":2},{"id":"span.4","tag":"span","n":4,"role":"label","group":null,"inNav":false,"text":"The Operating System","chars":20,"words":3},{"id":"span.6","tag":"span","n":6,"role":"paragraph","group":null,"inNav":false,"text":"It's free to start, and you're in good hands the whole way.","chars":59,"words":12},{"id":"h2.0","tag":"h2","n":0,"role":"title","group":null,"inNav":true,"text":"Tell us where to start","chars":22,"words":5},{"id":"p.1","tag":"p","n":1,"role":"paragraph","group":null,"inNav":true,"text":"A couple of details and debian.org takes it from there — no account needed yet.","chars":79,"words":15},{"id":"span.7","tag":"span","n":7,"role":"label","group":null,"inNav":false,"text":"First name","chars":10,"words":2},{"id":"span.8","tag":"span","n":8,"role":"label","group":null,"inNav":false,"text":"Last name","chars":9,"words":2},{"id":"span.9","tag":"span","n":9,"role":"label","group":null,"inNav":false,"text":"Work email","chars":10,"words":2},{"id":"p.2","tag":"p","n":2,"role":"paragraph","group":null,"inNav":false,"text":"That doesn't look like an email yet — try name@company.com.","chars":59,"words":10},{"id":"p.3","tag":"p","n":3,"role":"paragraph","group":null,"inNav":false,"text":"We'll send your next steps here.","chars":32,"words":6},{"id":"span.10","tag":"span","n":10,"role":"label","group":null,"inNav":false,"text":"What can we help with?","chars":22,"words":5},{"id":"option.0","tag":"option","n":0,"role":"label","group":null,"inNav":false,"text":"Choose one…","chars":11,"words":2},{"id":"option.1","tag":"option","n":1,"role":"label","group":null,"inNav":false,"text":"Debian","chars":6,"words":1},{"id":"option.2","tag":"option","n":2,"role":"label","group":null,"inNav":false,"text":"The Community","chars":13,"words":2},{"id":"option.3","tag":"option","n":3,"role":"label","group":null,"inNav":false,"text":"The Operating System","chars":20,"words":3},{"id":"p.4","tag":"p","n":4,"role":"paragraph","group":null,"inNav":false,"text":"Pick the closest — you can change direction later.","chars":50,"words":9},{"id":"span.11","tag":"span","n":11,"role":"label","group":null,"inNav":false,"text":"Anything we should know?","chars":24,"words":4},{"id":"span.12","tag":"span","n":12,"role":"label","group":null,"inNav":false,"text":"Optional","chars":8,"words":1},{"id":"span.13","tag":"span","n":13,"role":"paragraph","group":null,"inNav":false,"text":"Keep me posted on what's new at debian.org. No noise, easy to turn off.","chars":71,"words":14},{"id":"a.0","tag":"a","n":0,"role":"button","group":null,"inNav":false,"text":"Get started with debian.org","chars":27,"words":4},{"id":"span.14","tag":"span","n":14,"role":"paragraph","group":null,"inNav":false,"text":"No spam, ever. Unsubscribe in one click — your data stays yours.","chars":64,"words":12},{"id":"h2.1","tag":"h2","n":1,"role":"title","group":null,"inNav":false,"text":"You're in.","chars":10,"words":2},{"id":"p.6","tag":"p","n":6,"role":"paragraph","group":null,"inNav":false,"text":"Check your inbox for a note from debian.org — your next step is waiting there. We usually reply within one business day.","chars":120,"words":22},{"id":"span.18","tag":"span","n":18,"role":"paragraph","group":null,"inNav":false,"text":"Debian -- The Universal Operating System","chars":40,"words":6},{"id":"span.19","tag":"span","n":19,"role":"label","group":null,"inNav":false,"text":"debian.org","chars":10,"words":1}]}
